[Unit]
Description=SmarterDog CleverDog camera backend and RTSP server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=smarterdog
WorkingDirectory=/opt/SmarterDog
ExecStart=/opt/SmarterDog/SmarterDog -S -c YOUR_CAMERA_CID
Restart=always
RestartSec=5
# Backend listens on port 443; allow binding it without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
